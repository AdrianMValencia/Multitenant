<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Multitenant.Web.Client._Imports).Assembly }">
    <Found Context="routeData">
        @* Layout por defecto = menú de la app autenticada. *@
        <RouteView RouteData="routeData" DefaultLayout="typeof(Multitenant.Web.Client.Shared.Layouts.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        @* Fallback del Router. Las URLs desconocidas también las cubre NotFoundPage (catch-all). *@
        <LayoutView Layout="typeof(Multitenant.Web.Client.Shared.Layouts.MainLayout)">
            <MudText Typo="Typo.h6">Página no encontrada</MudText>
        </LayoutView>
    </NotFound>
</Router>
